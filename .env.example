# ლოკალური დეველოპმენტი. დააკოპირე: cp .env.example .env
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# docker compose-ის Postgres
DATABASE_URL=postgresql://icomers:icomers@localhost:5432/icomers

SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RESERVATION_TTL_MINUTES=15

# დროებითი: როლები /v1/admin/*-ისთვის, სანამ Identity-ის JWT არ გვაქვს (იხ. src/modules/auth/admin.guard.ts).
# მუშაობს მხოლოდ NODE_ENV=development-ზე.
# შესაძლო: admin, manager, content_editor, warehouse
DEV_ADMIN_ROLES=admin
