# ლოკალური დეველოპმენტი. დააკოპირე: cp .env.example .env
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# docker compose-ის Postgres
DATABASE_URL=postgresql://icomers:icomers@localhost:5432/icomers

SWAGGER_ENABLED=true

# true → ლოგში ჩანს ყველა SQL query (რისთვის: ვნახო, რა SQL-ს აწარმოებს Prisma-ს კოდი).
# ლოგი ბევრი ხდება, ამიტომ ჩვეულებრივ false; NODE_ENV=development-ის გარეთ არ მოქმედებს.
LOG_SQL=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RESERVATION_TTL_MINUTES=15

# რამდენი reverse proxy დგას API-ს წინ (usectl: Cloudflare → Traefik → ადმინკის nginx = 3). ლოკალურად 0
TRUST_PROXY_HOPS=0

# --- ადმინის ავტორიზაცია ---
# ES256 private key (PKCS#8 PEM). ლოკალურად შეიძლება ცარიელი დარჩეს — დროებითი გასაღები შეიქმნება.
# production-ში სავალდებულოა. გენერაცია:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk 'NF {printf "%s\\n", $0}'
JWT_PRIVATE_KEY=
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=icomers-admin
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# პირველი superadmin — `pnpm db:seed` შექმნის (მხოლოდ თუ ჯერ არ არსებობს)
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=change-me-please
