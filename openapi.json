        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "ka",
              "en"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "კაბელები"
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "seo_title": {
            "type": "object",
            "nullable": true,
            "maxLength": 200
          },
          "seo_description": {
            "type": "object",
            "nullable": true,
            "maxLength": 500
          }
        },
        "required": [
          "locale",
          "name"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "example": "cables"
          },
          "parent_id": {
            "type": "object",
            "nullable": true,
            "format": "uuid",
            "description": "მშობელი კატეგორია; `null` — ზედა დონე"
          },
          "sort_order": {
            "type": "number",
            "default": 0,
            "minimum": 0
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "translations": {
            "description": "`ka` სავალდებულოა",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryTranslationDto"
            }
          }
        },
        "required": [
          "slug",
          "translations"
        ]
      },
